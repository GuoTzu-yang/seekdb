drop database if exists fts_char_boundary;
create database fts_char_boundary;
use fts_char_boundary;
set ob_query_timeout = 10000000000;
create table memo (id BIGINT AUTO_INCREMENT PRIMARY KEY, body VARCHAR(256) NOT NULL, FULLTEXT INDEX fti(body) WITH PARSER ik);
result_format: 4
select tokenize('一二三四五六七八九十', 'ik');
+--------------------------------------------------+
| tokenize('一二三四五六七八九十', 'ik')           |
+--------------------------------------------------+
| ["一二三四五六七八九十"]                         |
+--------------------------------------------------+
select tokenize('零壹贰叁肆伍陆柒捌玖拾', 'ik');
+-----------------------------------------------------+
| tokenize('零壹贰叁肆伍陆柒捌玖拾', 'ik')            |
+-----------------------------------------------------+
| ["零壹贰叁肆伍陆柒捌玖拾"]                          |
+-----------------------------------------------------+
select tokenize('第123章', 'ik');
+-----------------------------+
| tokenize('第123章', 'ik')   |
+-----------------------------+
| ["第", "123章"]             |
+-----------------------------+

select tokenize('数据库😀', 'ik');
+---------------------------------+
| tokenize('数据库😀', 'ik')       |
+---------------------------------+
| ["数据库"]                      |
+---------------------------------+

select tokenize('ＡＢＣ数据库', 'ik');
+--------------------------------------+
| tokenize('ＡＢＣ数据库', 'ik')       |
+--------------------------------------+
| ["数据库", "ａｂｃ"]                 |
+--------------------------------------+

select tokenize('数据库abc数据库', 'ik');
+-----------------------------------------+
| tokenize('数据库abc数据库', 'ik')       |
+-----------------------------------------+
| ["数据库", "abc"]                       |
+-----------------------------------------+

select tokenize('第一章第三节');
+--------------------------------+
| tokenize('第一章第三节')       |
+--------------------------------+
| ["第一章第三节"]               |
+--------------------------------+

insert into memo (body) values
  ('第一章第三节'),
  ('第123章'),
  ('零壹贰叁肆伍陆柒捌玖拾');
select count(*) from memo where match(body) against('第一章第三节');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from memo where match(body) against('第123章');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from memo where match(body) against('零壹贰叁肆伍陆柒捌玖拾');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
